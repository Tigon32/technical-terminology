{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared technical concepts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "version",
    "source",
    "concepts"
  ],
  "properties": {
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "term",
          "definition",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3
          },
          "term": {
            "type": "string",
            "minLength": 2
          },
          "definition": {
            "type": "string",
            "minLength": 10
          },
          "kind": {
            "enum": [
              "technical-noun",
              "technical-verb"
            ]
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "related": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "broader": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
